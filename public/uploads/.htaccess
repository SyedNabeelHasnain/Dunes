# Prevent script, HTML, or SVG active content execution inside uploads directory
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl .py .sh .shtml .html .htm .svg
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .html .htm .svg

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; sandbox"
</IfModule>

<FilesMatch "\.(php|phtml|phar|cgi|pl|py|sh|shtml|html|htm|svg|js|mjs)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
